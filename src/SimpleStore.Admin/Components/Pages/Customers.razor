@page "/customers"
@attribute [Authorize(Roles = "Admin")]
@inject IIdentityApiClient Identity
@inject IOrderApiClient OrderApi

<PageTitle>Customers</PageTitle>

<header class="page-header">
    <div>
        <h1>Customers</h1>
        <p class="page-subtitle">Browse customer accounts and manage access.</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info" role="alert">@message</div>
}

@if (isLoading)
{
    <p>Loading customers...</p>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Orders</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in customers)
                    {
                        <tr>
                            <td>
                                <InputText class="form-control form-control-sm" @bind-Value="customer.FullName" />
                            </td>
                            <td>@customer.Email</td>
                            <td>@string.Join(", ", customer.Roles)</td>
                            <td>@customer.OrderCount</td>
                            <td>
                                @if (customer.IsLocked)
                                {
                                    <span class="badge text-bg-danger">Locked</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => SaveCustomerAsync(customer)">Save</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleLockAsync(customer)">
                                    @(customer.IsLocked ? "Unlock" : "Lock")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private readonly List<CustomerRow> customers = [];
    private bool isLoading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        customers.Clear();

        // Single bulk fetch from each service; dictionary-join in memory to avoid per-user round trips.
        var orderCounts = await OrderApi.GetOrderCountsByUserAsync();
        var users = await Identity.GetUsersAsync(page: 1, pageSize: 100);

        foreach (var user in users.Items)
        {
            customers.Add(new CustomerRow
            {
                Id = user.Id,
                FullName = user.FullName,
                Email = user.Email,
                Roles = user.Roles,
                IsLocked = user.IsLockedOut,
                OrderCount = orderCounts.GetValueOrDefault(user.Id)
            });
        }

        isLoading = false;
    }

    private async Task SaveCustomerAsync(CustomerRow row)
    {
        await Identity.UpdateUserAsync(row.Id, new UpdateProfileRequest { FullName = row.FullName.Trim() });
        message = $"Updated {row.Email}.";
    }

    private async Task ToggleLockAsync(CustomerRow row)
    {
        if (row.IsLocked)
        {
            await Identity.UnlockUserAsync(row.Id);
            row.IsLocked = false;
            message = $"Unlocked {row.Email}.";
        }
        else
        {
            await Identity.LockUserAsync(row.Id);
            row.IsLocked = true;
            message = $"Locked {row.Email}.";
        }
    }

    private sealed class CustomerRow
    {
        public string Id { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public IReadOnlyList<string> Roles { get; set; } = Array.Empty<string>();
        public bool IsLocked { get; set; }
        public int OrderCount { get; set; }
    }
}
