@page "/products"
@attribute [Authorize(Roles = "Admin")]
@inject ICatalogApiClient Catalog

<PageTitle>Products</PageTitle>

<header class="page-header">
    <div>
        <h1>Products</h1>
        <p class="page-subtitle">Manage catalog items, pricing, and stock.</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info" role="alert">@message</div>
}

<div class="row g-3">
    <div class="col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">@(editingId is null ? "Create Product" : "Edit Product")</h5>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText class="form-control" @bind-Value="form.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <InputSelect class="form-select" @bind-Value="form.CategoryId">
                        <option value="0">Select category</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="form.Description" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Price</label>
                        <InputNumber class="form-control" @bind-Value="form.Price" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Stock</label>
                        <InputNumber class="form-control" @bind-Value="form.Stock" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Image URL</label>
                    <InputText class="form-control" @bind-Value="form.ImageUrl" />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                    @if (editingId is not null)
                    {
                        <button class="btn btn-outline-secondary" @onclick="ResetForm">Cancel</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.CategoryName</td>
                                <td>@product.Price.ToString("C")</td>
                                <td>@product.Stock</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Edit(product)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(product.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (totalPages > 1)
                {
                    <nav aria-label="Products pagination" class="mt-3">
                        <ul class="pagination justify-content-end mb-0">
                            <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                                <button type="button" class="page-link" @onclick="PreviousPage" disabled="@(currentPage <= 1)">Previous</button>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Page @currentPage of @totalPages</span>
                            </li>
                            <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                                <button type="button" class="page-link" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Next</button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const int PageSize = 20;

    private readonly List<ProductDto> products = [];
    private readonly List<CategoryDto> categories = [];
    private readonly ProductForm form = new() { ImageUrl = "/images/products/placeholder.jpg" };
    private int? editingId;
    private string? message;
    private int currentPage = 1;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
        await LoadProductsAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        categories.Clear();
        // Sidebar dropdown is small; ask for a large first page.
        var result = await Catalog.GetCategoriesAsync(page: 1, pageSize: 100);
        categories.AddRange(result.Items.OrderBy(c => c.Name));
    }

    private async Task LoadProductsAsync()
    {
        products.Clear();
        var result = await Catalog.GetProductsAsync(page: currentPage, pageSize: PageSize);
        products.AddRange(result.Items);
        totalPages = Math.Max(result.TotalPages, 1);
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
            await LoadProductsAsync();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await LoadProductsAsync();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await LoadProductsAsync();
    }

    private void Edit(ProductDto row)
    {
        editingId = row.Id;
        form.Name = row.Name;
        form.Description = row.Description;
        form.Price = row.Price;
        form.Stock = row.Stock;
        form.ImageUrl = row.ImageUrl;
        form.CategoryId = row.CategoryId;
        message = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Name) || form.CategoryId <= 0)
        {
            message = "Product name and category are required.";
            return;
        }

        var dto = new ProductDto
        {
            Name = form.Name.Trim(),
            Description = form.Description.Trim(),
            Price = form.Price,
            Stock = form.Stock,
            ImageUrl = string.IsNullOrWhiteSpace(form.ImageUrl) ? "/images/products/placeholder.jpg" : form.ImageUrl.Trim(),
            CategoryId = form.CategoryId
        };

        try
        {
            if (editingId is null)
            {
                await Catalog.CreateProductAsync(dto);
                message = "Product created.";
                currentPage = 1;
            }
            else
            {
                await Catalog.UpdateProductAsync(editingId.Value, dto);
                message = "Product updated.";
            }
        }
        catch (HttpRequestException ex)
        {
            message = $"Failed to save product: {ex.Message}";
            return;
        }

        await LoadProductsAsync();
        ResetForm();
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            await Catalog.DeleteProductAsync(id);
            message = "Product deleted.";
        }
        catch (HttpRequestException ex)
        {
            message = $"Failed to delete product: {ex.Message}";
            return;
        }

        await LoadProductsAsync();
    }

    private void ResetForm()
    {
        editingId = null;
        form.Name = string.Empty;
        form.Description = string.Empty;
        form.Price = 0m;
        form.Stock = 0;
        form.ImageUrl = "/images/products/placeholder.jpg";
        form.CategoryId = 0;
    }

    private class ProductForm
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int Stock { get; set; }
        public string ImageUrl { get; set; } = string.Empty;
        public int CategoryId { get; set; }
    }
}
