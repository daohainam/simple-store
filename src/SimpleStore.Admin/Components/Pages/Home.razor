@page "/"
@attribute [Authorize(Roles = "Admin")]
@inject ICatalogApiClient Catalog
@inject IIdentityApiClient Identity
@inject IOrderApiClient Orders

<PageTitle>Dashboard</PageTitle>

<header class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="page-subtitle">An overview of customers, catalog, and orders.</p>
    </div>
</header>

@if (isLoading)
{
    <p class="text-muted">Loading metrics&hellip;</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body stat-card">
                    <p class="stat-label">Customers</p>
                    <p class="stat-value">@customerCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body stat-card">
                    <p class="stat-label">Categories</p>
                    <p class="stat-value">@categoryCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body stat-card">
                    <p class="stat-label">Products</p>
                    <p class="stat-value">@productCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body stat-card">
                    <p class="stat-label">Orders</p>
                    <p class="stat-value">@stats.TotalCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title mb-3">Sales snapshot</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <p class="stat-label">Pending</p>
                    <p class="stat-value" style="font-size:1.25rem;">@stats.PendingCount</p>
                </div>
                <div class="col-md-4">
                    <p class="stat-label">Completed</p>
                    <p class="stat-value" style="font-size:1.25rem;">@stats.CompletedCount</p>
                </div>
                <div class="col-md-4">
                    <p class="stat-label">Total revenue</p>
                    <p class="stat-value" style="font-size:1.25rem;">@stats.TotalRevenue.ToString("C")</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private int customerCount;
    private int categoryCount;
    private int productCount;
    private OrderStatsDto stats = new();

    protected override async Task OnInitializedAsync()
    {
        customerCount = await Identity.GetUserCountAsync();
        categoryCount = await Catalog.GetCategoryCountAsync();
        productCount = await Catalog.GetProductCountAsync();
        stats = await Orders.GetStatsAsync();
        isLoading = false;
    }
}
