@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string IsActive(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<div class="list-group">
    <a class="list-group-item list-group-item-action @IsActive("/Account/Manage/Index")"
       asp-area="Identity" asp-page="/Account/Manage/Index">
        <i class="bi bi-person me-2"></i>Profile
    </a>
    <a class="list-group-item list-group-item-action @IsActive("/Account/Manage/Passkeys")"
       asp-area="Identity" asp-page="/Account/Manage/Passkeys">
        <i class="bi bi-fingerprint me-2"></i>Passkeys
    </a>
</div>
