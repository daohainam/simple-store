@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-center">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
                    </h1>

                    <form id="password-form" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
                        </button>
                    </form>

                    <div class="text-center my-3 text-muted small">or</div>

                    <button type="button" id="passkey-signin" class="btn btn-outline-primary w-100">
                        <i class="bi bi-fingerprint me-2"></i>Sign in with a passkey
                    </button>
                    <div id="passkey-error" class="text-danger small mt-2" role="alert"></div>

                    <hr class="my-4" />

                    <p class="text-center mb-0 small">
                        Don't have an account?
                        <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/passkeys.js" asp-append-version="true"></script>
    <script>
        document.getElementById('passkey-signin').addEventListener('click', async () => {
            const errorEl = document.getElementById('passkey-error');
            errorEl.textContent = '';
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReturnUrl ?? "/"));
                const redirectTo = await window.simpleStorePasskeys.signIn(token, returnUrl);
                window.location.href = redirectTo;
            } catch (e) {
                errorEl.textContent = e.message || 'Passkey sign-in failed.';
            }
        });
    </script>
}
