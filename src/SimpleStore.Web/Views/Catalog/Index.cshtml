@using SimpleStore.Catalog.API.Client
@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Product Catalog";
    var categories = ViewBag.Categories as IEnumerable<CategoryDto>;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
    string searchTerm = ViewBag.SearchTerm ?? "";
    var hasPrev = Model.Page > 1;
    var hasNext = Model.Page < Model.TotalPages;
}
<section class="hero-section py-5 mb-4">
    <div class="container position-relative">
        <h1 class="display-5 fw-bold"><i class="bi bi-grid me-2"></i>Product Catalog</h1>
        <p class="lead">Discover our amazing collection of products</p>
        <form method="get" class="d-flex gap-2 mt-3">
            <input type="text" name="search" value="@searchTerm" class="form-control form-control-lg" placeholder="Search products..." style="max-width: 400px;" />
            <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-search"></i></button>
        </form>
    </div>
</section>
<div class="container">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white"><h6 class="mb-0 text-white"><i class="bi bi-funnel me-2"></i>Categories</h6></div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Index")" class="list-group-item list-group-item-action @(selectedCategoryId == null ? "active" : "")">
                        <i class="bi bi-grid me-2"></i>All Products
                    </a>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <a href="@Url.Action("Index", new { categoryId = cat.Id })" class="list-group-item list-group-item-action @(selectedCategoryId == cat.Id ? "active" : "")">
                                <i class="bi bi-tag me-2"></i>@cat.Name
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            @if (!Model.Items.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search display-1 text-muted"></i>
                    <h3 class="mt-3">No products found</h3>
                    <a href="@Url.Action("Index")" class="btn btn-primary mt-2">View All Products</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var product in Model.Items)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm product-card">
                                <div class="product-image-container bg-light d-flex align-items-center justify-content-center" style="height:200px; overflow:hidden;">
                                    <i class="bi bi-box-seam display-1 text-secondary"></i>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <span class="badge bg-secondary mb-2 align-self-start">@product.CategoryName</span>
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="fs-4 fw-bold text-primary">$@product.Price.ToString("N2")</span>
                                        <span class="text-muted small">@product.Stock in stock</span>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-top-0 pb-3">
                                    <div class="d-grid gap-2">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>View Details
                                        </a>
                                        <form asp-controller="Cart" asp-action="Add" method="post">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Catalog pagination" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(hasPrev ? "" : "disabled")">
                                <a class="page-link"
                                   href="@(hasPrev ? Url.Action("Index", new { categoryId = selectedCategoryId, search = searchTerm, page = Model.Page - 1 }) : "#")">
                                    <i class="bi bi-chevron-left"></i> Previous
                                </a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                            </li>
                            <li class="page-item @(hasNext ? "" : "disabled")">
                                <a class="page-link"
                                   href="@(hasNext ? Url.Action("Index", new { categoryId = selectedCategoryId, search = searchTerm, page = Model.Page + 1 }) : "#")">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
