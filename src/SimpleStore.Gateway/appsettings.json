{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-anon-login": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/login", "Methods": [ "POST" ] }
      },
      "identity-anon-register": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/register", "Methods": [ "POST" ] }
      },
      "identity-anon-refresh": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/refresh", "Methods": [ "POST" ] }
      },
      "identity-anon-logout": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/logout", "Methods": [ "POST" ] }
      },
      "identity-anon-pk-aopts": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/passkey/assertion-options", "Methods": [ "POST" ] }
      },
      "identity-anon-pk-assert": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/passkey/assertion", "Methods": [ "POST" ] }
      },

      "identity-admin-users": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/v1/identity/users/{**catch-all}" }
      },

      "identity-auth-rest": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/v1/identity/{**catch-all}" }
      },

      "catalog-read": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}", "Methods": [ "GET", "HEAD" ] }
      },
      "catalog-write": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE", "PATCH" ] }
      },

      "order-admin": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/v1/order/admin/{**catch-all}" }
      },
      "order-user": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/v1/order/{**catch-all}" }
      },

      "cart-merge": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/v1/cart/merge", "Methods": [ "POST" ] }
      },
      "cart-any": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/v1/cart/{**catch-all}" }
      },

      "inventory-admin": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/v1/inventory/{**catch-all}" }
      },

      "payment-admin": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/v1/payment/admin/{**catch-all}" }
      },
      "payment-user": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/v1/payment/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "primary": { "Address": "https+http://identity" }
        }
      },
      "catalog-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "primary": { "Address": "https+http://catalog" }
        }
      },
      "order-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "primary": { "Address": "https+http://order" }
        }
      },
      "cart-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "primary": { "Address": "https+http://cart" }
        }
      },
      "inventory-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "primary": { "Address": "https+http://inventory" }
        }
      },
      "payment-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "primary": { "Address": "https+http://payment" }
        }
      }
    }
  }
}
