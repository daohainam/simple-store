<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      v11: MassTransit.Abstractions gives us [MessageUrn] so each event type can pin its wire URN
      explicitly (decoupling the CLR type name from the bus identity). Abstractions-only — no
      transport, no DI, just the attributes/markers. Every existing consumer already references
      a heavier MassTransit package, so adding this here adds nothing transitively.
    -->
    <PackageReference Include="MassTransit.Abstractions" Version="9.1.2" />
  </ItemGroup>

</Project>
